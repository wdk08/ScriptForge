{
  "name": "scriptforge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local screenplay editor for macOS, Windows, and the browser",
  "scripts": {
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs",
    "vendor:tts": "node scripts/vendor-tts.mjs",
    "fetch:piper-test-voice": "node scripts/fetch-piper-test-voice.mjs",
    "test:piper": "node scripts/test-piper.mjs",
    "tauri": "tauri",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --config src-tauri/tauri.local.conf.json",
    "desktop:test": "node scripts/build-desktop.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "desktop:stress": "node scripts/stress-desktop.mjs",
    "release:check": "node scripts/release-check.mjs",
    "desktop:release": "node scripts/release-check.mjs --production && tauri build",
    "audit:public": "node scripts/audit-public.mjs",
    "licenses:generate": "node scripts/license-inventory.mjs --write",
    "licenses:check": "node scripts/license-inventory.mjs",
    "build:piper": "node scripts/build-piper.mjs",
    "release:source": "node scripts/source-release.mjs",
    "audit:history": "node scripts/audit-release-history.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/preview-web.mjs",
    "test:web": "playwright test --config=playwright.web.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.3",
    "fake-indexeddb": "^6.2.5"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "jspdf": "^4.2.1",
    "onnxruntime-web": "1.22.0"
  },
  "license": "GPL-3.0-only"
}
