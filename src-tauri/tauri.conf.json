{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptForge",
  "version": "1.0.1",
  "identifier": "com.scriptforge.desktop",
  "build": {
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ScriptForge",
        "width": 1440,
        "height": 1000,
        "minWidth": 720,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your local screenplay writing room",
    "longDescription": "Write, format, save and export screenplays locally, with table read playback and independent version-history backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 wdk08"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4QjcyQTI3RkZGOTNGNkIKUldSclAvbi9KeXEzQ09Ocnl5UVU0b25XMyt0S0pHeWxUMldPZ0dmeFAyTnpnQWtaNURSVFBTc2wK",
      "endpoints": [
        "https://github.com/wdk08/ScriptForge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
